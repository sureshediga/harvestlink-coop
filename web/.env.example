# Stripe (Card, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Site URL (used for payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional — falls back to local data/members.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin CSV export (optional)
ADMIN_EXPORT_KEY=change-me-to-a-secure-random-string

# Signing secret for certificate/ID verification + instructions access tokens
# (set a long random string in production; a dev fallback is used if unset)
CERT_SIGNING_SECRET=change-me-to-a-long-random-string

# Email — used to send membership/investor certificates and ID cards.
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=HarvestLinx Cooperative <harvestlinx@gmail.com>
# Option B: SMTP (e.g. Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=harvestlinx@gmail.com
# SMTP_PASS=
